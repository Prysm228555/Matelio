{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card">
            <div class="auth-brand">
                <span class="auth-brand-icon">M</span>
                <span class="auth-brand-text">Matelio</span>
            </div>

            <div class="auth-heading">
                <span class="auth-kicker">Accueil</span>
                <h1>Bienvenue</h1>
                <p>Votre espace Matelio est prêt.</p>
            </div>

            <div class="auth-links">
                {% if app.user %}
                    <a href="{{ logout_path() }}">Se déconnecter</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Se connecter</a>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
