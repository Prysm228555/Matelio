{# La page d’inscription a été retirée du parcours applicatif. #}
{% extends 'base.html.twig' %}

{% block title %}Inscription désactivée{% endblock %}

{% block body %}
    <div class="auth-page">
        <div class="auth-card auth-card-register">
            <div class="auth-brand">
                <span class="auth-brand-icon">M</span>
                <span class="auth-brand-text">Matelio</span>
            </div>

            <div class="auth-heading">
                <span class="auth-kicker">Accès</span>
                <h1>Inscription désactivée</h1>
                <p>Cette instance n’accepte pas la création de compte.</p>
            </div>

            <div class="auth-links">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}